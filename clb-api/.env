# ============================================================================
# CLB API - Configuración de Producción (MSSQL Server + Redis + Cluster)
# Windows Server 2025
# ============================================================================

# --- Servidor ---
PORT=3001
HOST=0.0.0.0
NODE_ENV=production
WORKER_COUNT=0  # 0 = usar todos los núcleos CPU (cluster automático)

# --- Base de datos MSSQL Server ---
DB_TYPE=mssql
DB_HOST=localhost
DB_PORT=1433
DB_USER=clb_app
DB_PASSWORD=CambiarEstaContrasenaSegura2025!
DB_DATABASE=CLB_DB
DB_CONNECTION_TIMEOUT=30000
DB_REQUEST_TIMEOUT=30000
DB_POOL_MAX=100
DB_POOL_MIN=10
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_ENABLE_READ_COMMITTED_SNAPSHOT=true

# --- Redis (caché, rate limiting, sesiones) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CONNECT_TIMEOUT=10000
REDIS_MAX_RETRIES=10

# --- JWT ---
JWT_ACCESS_SECRET=ClbJwtAccessSecret_MuySeguro_2025_Nacional!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=ClbJwtRefreshSecret_MuySeguro_2025_Nacional!
JWT_REFRESH_EXPIRES_IN=7d

# --- Rate Limiting (Throttler) ---
RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT_AUTH=10        # login/register por minuto por IP
RATE_LIMIT_LIMIT_GENERAL=100    # requests por minuto por IP (endpoints generales)
RATE_LIMIT_LIMIT_ADMIN=500      # requests por minuto por IP (endpoints admin)
RATE_LIMIT_LIMIT_WRITE=30       # requests POST/PUT/DELETE por minuto por IP

# --- CORS ---
CORS_ORIGIN=https://app.clb.do,https://www.clb.do
CORS_CREDENTIALS=true

# --- Logging ---
LOG_LEVEL=info
LOG_DIR=./logs

# --- Salud (Health Check) ---
HEALTH_CHECK_ENABLED=true