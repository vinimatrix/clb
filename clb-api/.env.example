# ============================================================================
# CLB API - Archivo de variables de entorno (EJEMPLO)
# ============================================================================
# Copia este archivo a .env y llena los valores reales para tu entorno.
# NUNCA subas el .env con credenciales reales a control de versiones.
# ============================================================================

# --- Servidor ---
PORT=3001
HOST=0.0.0.0
NODE_ENV=production
# 0 = usar todos los núcleos CPU (cluster automático de Node.js/PM2)
WORKER_COUNT=0

# --- Base de datos MSSQL Server (sql.pigesolutions.com) ---
DB_HOST=sql.pigesolutions.com
DB_PORT=1433
DB_USER=usr_development
DB_PASSWORD=TU_PASSWORD_REAL_AQUI
DB_DATABASE=CLB_DB
DB_CONNECTION_TIMEOUT=30000
DB_REQUEST_TIMEOUT=30000
# Pool de conexiones: ajusta según límites de tu hosting
DB_POOL_MAX=100
DB_POOL_MIN=10
DB_POOL_IDLE_TIMEOUT_MS=30000
# Para conexiones remotas a SQL Server, usualmente se requiere encrypt=true
DB_ENABLE_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=true
DB_ENABLE_READ_COMMITTED_SNAPSHOT=true

# --- Redis (caché, rate limiting, sesiones) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=TU_REDIS_PASSWORD_SI_TIENES
REDIS_DB=0
REDIS_CONNECT_TIMEOUT=10000
REDIS_MAX_RETRIES=10

# --- JWT (cambia estos secretos en producción por valores largos y aleatorios) ---
JWT_ACCESS_SECRET=TU_JWT_ACCESS_SECRET_MUY_SEGURO_AQUI
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=TU_JWT_REFRESH_SECRET_MUY_SEGURO_AQUI
JWT_REFRESH_EXPIRES_IN=7d

# --- Rate Limiting (Throttler) ---
RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT_AUTH=10        # login/register por minuto por IP
RATE_LIMIT_LIMIT_GENERAL=100    # requests por minuto por IP (endpoints generales)
RATE_LIMIT_LIMIT_ADMIN=500      # requests por minuto por IP (endpoints admin)
RATE_LIMIT_LIMIT_WRITE=30       # requests POST/PUT/DELETE por minuto por IP

# --- CORS (dominios permitidos para el frontend) ---
# Ejemplo: CORS_ORIGIN=https://app.clb.do,https://www.clb.do
CORS_ORIGIN=TU_DOMINIO_FRONTEND_AQUI
CORS_CREDENTIALS=true

# --- Logging ---
LOG_LEVEL=info
LOG_DIR=./logs

# --- Salud (Health Check) ---
HEALTH_CHECK_ENABLED=true
